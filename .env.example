# Server-only Pipedrive token used by Ava lead capture and existing form flows.
PIPEDRIVE_API_KEY=

# Optional: enable Groq-generated Ava responses. Without this, Ava uses the local knowledge base.
GROQ_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Preferred provider for Ava. Keep this key server-side in .env.local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
